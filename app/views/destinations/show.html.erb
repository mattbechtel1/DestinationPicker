<article class="destination-hero page-show-hero <%= region_color_class(@destination.region) %>">
  <span class="region-badge"><%= @destination.region.name %></span>

  <h1 class="destination-hero__title">
    <span class="flag-emoji flag-emoji--xl"><%= @destination.flags[0].get_flag_emoji %></span>
    <%= @destination.name %>
    <span class="flag-emoji flag-emoji--xl"><%= @destination.flags[1].get_flag_emoji %></span>
  </h1>

  <p class="destination-hero__languages">
    <%= @destination.languages.size > 1 ? "Languages" : "Language" %>:
    <%= @destination.languages.map(&:name).join(" & ") %>
  </p>

  <section class="cities-section">
    <h2>Primary Cities</h2>
    <ul class="city-list city-list--chips">
      <% @destination.cities.each do |city| %>
        <li><%= link_to city, wikivoyage_url(city), class: "city-chip", target: "_blank", rel: "noopener" %></li>
      <% end %>
    </ul>
  </section>

  <% if @destination.divisions %>
    <p class="jurisdictions">Sub-jurisdictions: <%= @destination.divisions %></p>
  <% end %>
</article>
